{
  "expo": {
    "name": "Bugün Ne Yapalım?",
    "slug": "bugun-ne-yapalim",
    "scheme": "bugunneyapalim",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.beratoguzhan.bugunneyapalim",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1F2A37",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.beratoguzhan.bugunneyapalim",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Bugün Ne Yapalım?",
      "shortName": "Ne Yapalım",
      "themeColor": "#1F2A37",
      "backgroundColor": "#F7F6F3",
      "description": "Tek dokunuşla bugün için bir aktivite önerisi: hareket, zihin, sosyal ve ev."
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#F7F6F3",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#141413"
          }
        }
      ]
    ],
    "description": "Tek dokunuşla bugün için bir aktivite önerisi: hareket, zihin, sosyal ve ev.",
    "primaryColor": "#2B5C8A",
    "backgroundColor": "#F7F6F3"
  }
}
